# 复制为 .env 后填写。本文件只有空白示例，实际密钥不提交 Git。
# .env 非空值覆盖本机配置和 YAML，但不覆盖已有进程环境变量。

# 百炼可填写 LLM_API_KEY 或 DASHSCOPE_API_KEY，前者优先。
LLM_API_KEY=
# DASHSCOPE_API_KEY=

# 留空沿用本机配置或默认百炼北京兼容地址。
# 若使用其他服务，需同时填写该服务的密钥、地址和模型。
LLM_BASE_URL=
# 留空沿用本机配置或默认 qwen-plus。
LLM_MODEL=

# 数据目录可选；默认 ./data。
# POLICY_DATA_DIR=/absolute/path/to/policy-data
