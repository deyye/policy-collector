# 复制为 .env 后填写本地密钥/参数。.env 已被 .gitignore，不会提交。
# 所有项都可省略：不配置模型时自动回退规则分类（--prefer rule 同效果）。

# ---- 大模型（OpenAI Chat Completions 兼容接口，必须支持 JSON 输出模式）----
# 密钥：必填才能启用大模型分类；只从环境变量/.env 读取，不写入配置与日志
LLM_API_KEY=
# 服务地址：留空默认 https://api.openai.com/v1
# 单位/云端示例：https://dashscope.aliyuncs.com/compatible-mode/v1（通义）
#                https://api.deepseek.com/v1
LLM_BASE_URL=
# 模型名：留空则无隐式默认；示例 deepseek-chat / qwen-plus / gpt-4o-mini
LLM_MODEL=

# ---- 数据目录（可选，默认 ./data）----
# POLICY_DATA_DIR=/absolute/path/to/policy-data
